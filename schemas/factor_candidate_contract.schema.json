{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-detective.invalid/schemas/factor_candidate_contract.schema.json",
  "title": "Candidate factor contracts (contracts/factors/candidates_2026*.json)",
  "description": "Structural contract for candidate factor contracts. All candidates are NOT_VALIDATED and NOT scoring-usable until promoted through validation_kernel evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status_note", "lifecycle_extension", "candidates"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "status_note": {"type": "string", "minLength": 1},
    "lifecycle_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_status"],
      "properties": {
        "validation_status": {"type": "array", "minItems": 1, "items": {"const": "NOT_VALIDATED"}}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/candidate"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"id": {"const": "gross_profitability"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "sloan_accruals"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "max_lottery"}}, "required": ["id"]}}
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ianaTimezone": {"type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_+\\-0-9]+)+$|^UTC$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "source", "known_at"],
      "properties": {
        "field": {"$ref": "#/$defs/nonEmptyString"},
        "source": {"$ref": "#/$defs/nonEmptyString"},
        "known_at": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "definition"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"enum": ["primary", "alternative"]},
        "definition": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_required", "known_at_required", "known_at_timezone_aware", "missing_is_not_zero"],
      "properties": {
        "source_required": {"const": true},
        "known_at_required": {"const": true},
        "known_at_timezone_aware": {"const": true},
        "missing_is_not_zero": {"const": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "rank", "name", "CONTRACT_STATUS", "DATA_STATUS", "VALIDATION_STATUS",
        "scoring_usable", "scoring_blocker", "formula", "inputs", "variants", "provenance",
        "pit_rule", "missing_rule", "direction_hypothesis", "implementation", "tests",
        "data_gaps", "definition_status", "required_record_fields"
      ],
      "properties": {
        "id": {"enum": ["gross_profitability", "sloan_accruals", "max_lottery"]},
        "rank": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "CONTRACT_STATUS": {"enum": ["READY", "NOT READY"]},
        "DATA_STATUS": {"enum": ["READY", "PARTIAL", "UNAVAILABLE"]},
        "VALIDATION_STATUS": {"const": "NOT_VALIDATED"},
        "scoring_usable": {"const": false},
        "scoring_blocker": {"$ref": "#/$defs/nonEmptyString"},
        "formula": {"$ref": "#/$defs/nonEmptyString"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"},
                     "contains": {"type": "object", "properties": {"role": {"const": "primary"}}, "required": ["role"]}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "pit_rule": {"$ref": "#/$defs/nonEmptyString"},
        "missing_rule": {"$ref": "#/$defs/nonEmptyString"},
        "direction_hypothesis": {"$ref": "#/$defs/nonEmptyString"},
        "implementation": {"type": "string", "pattern": "^factor_candidates/[a-z_]+\\.py$"},
        "tests": {"type": "string", "pattern": "^tests/test_[a-z_0-9]+\\.py$"},
        "data_gaps": {"$ref": "#/$defs/nonEmptyString"},
        "definition_status": {"$ref": "#/$defs/nonEmptyString"},
        "required_record_fields": {
          "type": "array", "minItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "allOf": [
            {"contains": {"const": "security"}},
            {"contains": {"const": "known_at"}},
            {"contains": {"const": "source"}},
            {"contains": {"const": "revision"}}
          ]
        },
        "calendar_timezone": {"$ref": "#/$defs/ianaTimezone"}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "max_lottery"}}, "required": ["id"]},
          "then": {
            "required": ["calendar_timezone"],
            "properties": {
              "variants": {"allOf": [
                {"contains": {"type": "object", "properties": {"name": {"const": "prior_calendar_month"}, "role": {"const": "primary"}}, "required": ["name", "role"]}},
                {"contains": {"type": "object", "properties": {"name": {"const": "fixed_21_trading_days"}, "role": {"const": "alternative"}}, "required": ["name", "role"]}}
              ]},
              "required_record_fields": {"allOf": [
                {"contains": {"const": "day"}}, {"contains": {"const": "adjustment_basis"}}, {"contains": {"const": "ret"}}
              ]}
            }
          },
          "else": {
            "not": {"required": ["calendar_timezone"]},
            "properties": {
              "required_record_fields": {"allOf": [
                {"contains": {"const": "period_end"}}, {"contains": {"const": "period_type"}},
                {"contains": {"const": "currency"}}, {"contains": {"const": "unit_scale"}},
                {"contains": {"const": "statement_ref"}}
              ]}
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "sloan_accruals"}}, "required": ["id"]},
          "then": {
            "properties": {
              "inputs": {"contains": {"type": "object", "properties": {"field": {"pattern": "short_term_investments"}}, "required": ["field"]}}
            }
          }
        }
      ]
    }
  }
}
